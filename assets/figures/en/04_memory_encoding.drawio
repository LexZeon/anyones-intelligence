        </mxCell>
        <mxCell id="item-31-line-0" value="More readily evoked by related cues" style="text;html=0;whiteSpace=nowrap;overflow=visible;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;align=center;fontFamily=DejaVu Sans;fontSize=20;fontStyle=0;fontColor=#17212B;" vertex="1" parent="1">
