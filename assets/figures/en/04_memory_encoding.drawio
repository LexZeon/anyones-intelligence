        <mxCell id="item-29-line-1" value="such as anxiety or fear" style="text;html=0;whiteSpace=nowrap;overflow=visible;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;align=left;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#5B6775;" vertex="1" parent="1">
