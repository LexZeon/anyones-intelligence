        <mxCell id="item-48-line-0" value="本文尚未说明具体组件对应；不表示记忆等于 V、词元等于 Q / K，" style="text;html=0;whiteSpace=nowrap;overflow=visible;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;fontColor=#5B6775;" vertex="1" parent="1">
          <mxGeometry x="76" y="925" width="569.003594" height="25.65" as="geometry" />
        </mxCell>
        <mxCell id="item-48-line-1" value="也不表示生理状态等于注意力权重。" style="text;html=0;whiteSpace=nowrap;overflow=visible;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;fillColor=none;strokeColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=0;fontColor=#5B6775;" vertex="1" parent="1">
